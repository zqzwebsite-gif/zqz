{
  "appId": "ir.zqz.app",
  "appName": "کوتاه کننده لینک ZQZ",
  "webDir": "dist",
  "server": {
    "url": "https://zqz.ir",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#ffffff",
      "showSpinner": true,
      "androidSpinnerStyle": "large",
      "iosSpinnerStyle": "small",
      "spinnerColor": "#4f46e5",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#4f46e5"
    }
  }
}